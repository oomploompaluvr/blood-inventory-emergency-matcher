# Copy to .env.local and fill in. Never commit .env.local.
# Any long random strings work for the passwords below — the setup scripts create these MySQL accounts.

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=lifeline
# Schema owner: used only by db/reset.sh, db/run-tests.sh and the seed script
MYSQL_OWNER_USER=lifeline_owner
MYSQL_OWNER_PASSWORD=change-me-owner
# One MySQL account per app role (ll_admin, ll_lab, ll_hospital, ll_donor)
MYSQL_ADMIN_PASSWORD=change-me-admin
MYSQL_LAB_PASSWORD=change-me-lab
MYSQL_HOSPITAL_PASSWORD=change-me-hospital
MYSQL_DONOR_PASSWORD=change-me-donor

# MongoDB (local: mongodb://127.0.0.1:27017, or an Atlas mongodb+srv:// URI)
MONGODB_URI=
MONGODB_DB=lifeline

# Session signing secret (Member B's authentication)
SESSION_SECRET=change-me-to-a-long-random-string
